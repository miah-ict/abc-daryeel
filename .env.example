VITE_APP_NAME=ABC Daycare & Kindergarten
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/abc

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5000
NODE_ENV=development
TRUST_PROXY=false

# Sifalo Hosted Checkout. Keep credentials server-only. Use a public HTTPS
# PUBLIC_APP_URL for staging callbacks and create separate keys for live.
SIFALO_ENV=staging
SIFALO_API_USER=your_staging_username
SIFALO_API_KEY=your_staging_api_key
# Seed is explicit and intended for an empty development database.
SEED_ADMIN_EMAIL=superadmin@abc.edu
SEED_ADMIN_PASSWORD=

# SMTP is required for account-verification email. Keep these server-only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM="ABC Daycare <you@example.com>"
