VITE_APP_NAME=ABC Daycare & Kindergarten
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/abc

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5000
NODE_ENV=development
TRUST_PROXY=false

# Sifalo Hosted Checkout. Keep credentials server-only. Use a public HTTPS
# PUBLIC_APP_URL for staging callbacks and create separate keys for live.
SIFALO_ENV=staging
SIFALO_API_USER=your_staging_username
SIFALO_API_KEY=your_staging_api_key
# Seed is explicit and intended for an empty development database.
SEED_ADMIN_EMAIL=superadmin@abc.edu
SEED_ADMIN_PASSWORD=

# Optional SMTP fallback for hosts that allow outbound SMTP. Render Free blocks
# ports 25, 465, and 587, so use the Brevo HTTP API settings below on Render.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM="ABC Daycare <you@example.com>"

# Recommended on Render Free: HTTP email API uses port 443 because free
# instances block outbound SMTP ports 25, 465, and 587.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=ABC Daycare
